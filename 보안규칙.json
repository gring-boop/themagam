{
  "rules": {
    "messages": {
      ".read": true,
      ".write": "auth != null"
    },
    "reactions": {
      ".read": true,
      ".write": "auth != null"
    },
    "chatMeta": {
      ".read": true,
      ".write": "auth != null"
    },
    "status": {
      ".read": true,
      "$nick": {
        ".write": "auth != null && root.child('nickOwner').child($nick).val() === auth.uid"
      }
    },
    "users": {
      ".read": true,
      "$nick": {
        ".write": "auth != null && root.child('nickOwner').child($nick).val() === auth.uid"
      }
    },
    "pomodoro": {
      ".read": true,
      ".write": "auth != null"
    },
    "attendance": {
      ".read": true,
      ".write": "auth != null"
    },
    "config": {
      ".read": true,
      ".write": "auth != null"
    },
    "nickOwner": {
      ".read": true,
      "$nick": {
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid",
        ".validate": "newData.isString()"
      }
    }
  }
}
